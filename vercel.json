{
  "headers": [
    {
      "source": "/beta/(emoji|fx|sfx)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/beta/av.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/beta/(pt.js|skins.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(av.js|skins.css|pt.js|en.js|ru.js|news.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/snd/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/beta",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/beta/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/beta/(.*)",
      "destination": "/",
      "permanent": false
    }
  ]
}